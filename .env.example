# Notion 내부 통합(Integration) 시크릿. https://www.notion.so/profile/integrations 에서 발급
NOTION_TOKEN=
# 캘린더로 쓸 데이터베이스 ID (DB URL의 32자리 hex). 해당 DB에 통합을 '연결'해야 함
NOTION_DATABASE_ID=

# 선택: 속성 이름을 직접 지정 (비우면 자동 탐지: 첫 title / 첫 date / 첫 select·status)
NOTION_TITLE_PROP=
NOTION_DATE_PROP=
NOTION_CATEGORY_PROP=

# 선택: 앱 접근 암호 (배포 URL이 노출되어도 일정 수정을 막음)
APP_PASSCODE=

# 선택: 공휴일 ICS 피드 (기본: Google 대한민국 공휴일)
HOLIDAY_ICS_URL=
PORT=3000
